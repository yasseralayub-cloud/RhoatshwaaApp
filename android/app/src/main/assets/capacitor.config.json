{
	"appId": "com.mycompany.rehlatshwaa",
	"appName": "رحلة شواء",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": true,
			"providers": [
				"phone"
			]
		},
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"LocalNotifications": {
			"smallIcon": "ic_stat_name",
			"iconColor": "#eab308"
		}
	}
}
